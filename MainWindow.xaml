    </ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Star" TargetType="ToggleButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Border Width="22" Height="22" CornerRadius="11" Background="#A0000000"><TextBlock x:Name="st" Text="☆" Foreground="#E0FFFFFF" FontSize="13" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
