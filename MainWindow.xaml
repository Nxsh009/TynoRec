      <Border x:Name="bd" Width="30" Height="26" CornerRadius="6" Background="Transparent"><TextBlock x:Name="ic" Text="👁" Foreground="#8B93A7" FontSize="15" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
