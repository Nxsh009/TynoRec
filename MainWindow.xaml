          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" Padding="0,11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border x:Name="hv" CornerRadius="12" Background="White" Opacity="0" IsHitTestVisible="False"/>
          <Border Width="3" Height="22" CornerRadius="0,3,3,0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-12,0,0,0" Background="{TemplateBinding BorderBrush}"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QCard" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Padding" Value="16,14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Padding" Value="12,9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="bd" Background="#171B24" BorderBrush="#2D3445" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#4C8DFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,6"/></Style>
    <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="Foreground" Value="#8B93A7"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="2,0,0,6"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="tr" Width="42" Height="24" CornerRadius="12" Background="#262D3C" BorderBrush="#3D4659" BorderThickness="1" VerticalAlignment="Center">
            <Ellipse x:Name="th" Width="16" Height="16" Fill="#B7BDCC" HorizontalAlignment="Left" Margin="4,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="tt" X="0"/></Ellipse.RenderTransform></Ellipse>
          </Border>
          <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0" RecognizesAccessKey="True"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tr" Property="BorderBrush" Value="#4C8DFF"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="tr" Property="Background" Value="#4C8DFF"/><Setter TargetName="tr" Property="BorderBrush" Value="#4C8DFF"/><Setter TargetName="th" Property="Fill" Value="White"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="DisplayMemberPath" Value="T"/><Setter Property="SelectedValuePath" Value="V"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{Binding C}"/><Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="bd" CornerRadius="6" Margin="2,1" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="#232A38"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="#1C3158"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton x:Name="tb" ClickMode="Press" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="bg" Background="#171B24" BorderBrush="#2D3445" BorderThickness="1" CornerRadius="8"><Path Data="M0,0 L4,4 L8,0" Stroke="#8B93A7" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="#4C8DFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Margin="26,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Border Background="#171B24" BorderBrush="#2D3445" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,4,0,8" MinWidth="{Binding ActualWidth, ElementName=tb}" MaxHeight="320"><ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer></Border>
        </Popup></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Chip" TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="b" Background="#161A23" CornerRadius="10" Padding="8,6"><ContentPresenter VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#222836"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Pick" TargetType="ToggleButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="bd" Width="20" Height="20" CornerRadius="10" Background="#A0000000" BorderBrush="#CCFFFFFF" BorderThickness="1.5"><TextBlock x:Name="ck" Text="✓" Opacity="0" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="#4C8DFF"/><Setter TargetName="bd" Property="BorderBrush" Value="#4C8DFF"/><Setter TargetName="ck" Property="Opacity" Value="1"/></Trigger>
