            </Canvas>
            <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
              <Rectangle x:Name="headLine" Width="2" Fill="#4C8DFF" Canvas.Top="16" Height="74"/>
              <Border x:Name="headKnob" Width="12" Height="12" CornerRadius="3" Background="#4C8DFF" Canvas.Top="10"/>
            </Canvas>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="authLayer" Grid.ColumnSpan="2" Background="#FF090B10" KeyDown="AuthKey">
      <StackPanel x:Name="authWait" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="Assets/logo.png" Width="72" Margin="0,0,0,12"/>
        <TextBlock Text="Connexion…" Foreground="#8B93A7" HorizontalAlignment="Center"/>
      </StackPanel>
      <ScrollViewer x:Name="authForm" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Panel}" Width="420" Padding="34,30,34,26" Margin="0,30" VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel>
            <Image Source="Assets/logo.png" Width="52" Margin="0,0,0,10"/>
            <TextBlock x:Name="aTitle" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock x:Name="aHint" Style="{StaticResource Lbl}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
            <StackPanel x:Name="aFEmail"><TextBlock Style="{StaticResource Lbl}" Text="EMAIL"/><TextBox x:Name="aEmail"/></StackPanel>
            <StackPanel x:Name="aFUser"><TextBlock Style="{StaticResource Lbl}" Text="NOM D'UTILISATEUR"/><TextBox x:Name="aUser" MaxLength="24"/></StackPanel>
            <StackPanel x:Name="aFCode" Visibility="Collapsed"><TextBlock Style="{StaticResource Lbl}" Text="CODE REÇU PAR EMAIL"/><TextBox x:Name="aCode" MaxLength="12"/></StackPanel>
            <StackPanel x:Name="aFPass">
              <TextBlock x:Name="aPassLbl" Style="{StaticResource Lbl}" Text="MOT DE PASSE"/>
              <Grid Margin="0,0,0,16">
                <PasswordBox x:Name="aPass" Margin="0" Padding="12,9,48,9"/>
                <TextBox x:Name="aPassTxt" Visibility="Collapsed" Margin="0" Padding="12,9,48,9"/>
                <ToggleButton x:Name="aEye" Style="{StaticResource Eye}" Click="AuthEye" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Afficher / masquer le mot de passe"/>
              </Grid>
            </StackPanel>
            <TextBlock x:Name="aErr" Foreground="#FF8097" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
            <TextBlock x:Name="aInfo" Foreground="#7FE3A4" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
            <Button x:Name="aGo" Style="{StaticResource Pri}" Click="AuthGo" HorizontalAlignment="Stretch" Margin="0,4,0,14"/>
            <TextBlock x:Name="aLinkForgot" Text="Mot de passe oublié ?" Foreground="#6FA3FF" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Center" MouseLeftButtonUp="AuthForgot" Margin="0,0,0,10"/>
            <TextBlock x:Name="aLinkSwitch" Foreground="#6FA3FF" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Center" MouseLeftButtonUp="AuthSwitch" Margin="0"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
